{
  "name": "pi-issue-tracker",
  "version": "1.0.0",
  "description": "An issue-tracker extension for pi that turns goals into linked, tracked user stories stored in a project-local SQLite database.",
  "keywords": [
    "pi-package",
    "pi",
    "issue-tracker",
    "project-management",
    "stories"
  ],
  "license": "MIT",
  "type": "module",
  "scripts": {
    "test": "node --test 'test/*.test.ts'",
    "typecheck": "npm --prefix tools/typecheck install --no-audit --no-fund --silent && npm --prefix test/tui install --no-audit --no-fund --silent && node tools/typecheck/node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "test:container": "test/container/run.sh",
    "test:tui": "npm --prefix test/tui install --no-audit --no-fund --silent && node --test 'test/tui/*.test.ts'"
  },
  "author": "Marco Zocca",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ocramz/pi-agent-experiments.git",
    "directory": "pi-issue-tracker"
  },
  "homepage": "https://github.com/ocramz/pi-agent-experiments/tree/main/pi-issue-tracker#readme",
  "bugs": {
    "url": "https://github.com/ocramz/pi-agent-experiments/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "extensions/",
    "src/",
    "LICENSE",
    "README.md",
    "package.json"
  ],
  "pi": {
    "extensions": [
      "./extensions/index.ts"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": { "optional": true },
    "@earendil-works/pi-coding-agent": { "optional": true },
    "@earendil-works/pi-tui": { "optional": true },
    "typebox": { "optional": true }
  }
}
