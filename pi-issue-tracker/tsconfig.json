{
	// Everything but `include` lives in the shared base — see the notes there for
	// why the pi declarations are mapped to files rather than directories, and why
	// they sit outside this package.
	"extends": "../shared/tsconfig.base.json",
	// The third pattern reaches test/tui, and the fourth reaches the shared pty
	// harness those tests drive. Both import `cli-testing-library` and
	// `strip-ansi` from shared/test/tui/node_modules — a scope no package carries;
	// see the description in shared/test/tui/package.json for why it sits off to
	// one side. Nothing configured here points at it: node's own directory walk
	// finds it from the importing file, and the compiler follows the same walk. So
	// the check needs that scope installed, which is why the `typecheck` script
	// installs it alongside shared/typecheck. Missing, it fails loudly rather than
	// degrading to `any` — the opposite of the pi declarations in the base, and
	// the reason this only ever broke on a clean checkout.
	"include": [
		"src/**/*.ts",
		"extensions/**/*.ts",
		"test/**/*.ts",
		"../shared/test/tui/**/*.ts"
	]
}
