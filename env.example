# Copy to .env (gitignored) and fill in:
#
#   cp env.example .env
#
# .env is passed to the devcontainer with podman --env-file, and forwarded into
# each inner test container by shared/test/container/run-suites.sh.
#
# The container suite drives a real model and refuses to run without this.
OPENROUTER_API_KEY=

# Only needed by pi-web-search: its tool reads this at execute time, and its
# live TUI tier (test/tui/live.test.ts) refuses to start without it, the same
# no-silent-skip rule as above. The unit and container tiers stub the network
# and run fine without it.
TAVILY_API_KEY=
