# Copy to .env (gitignored) and fill in:
#
#   cp env.example .env
#
# .env is passed to the devcontainer with podman --env-file, and forwarded into
# each inner test container by shared/test/container/run-suites.sh.
#
# The container suite drives a real model and refuses to run without this.
OPENROUTER_API_KEY=
